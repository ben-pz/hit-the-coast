{
  // Cloudflare Workers deployment config.
  //
  // This site is a pure static export — `npm run build` writes a folder of
  // HTML, CSS, JS and images to ./out and there is no server code at all.
  // So there is no `main` Worker script here: Cloudflare just serves the
  // files. Requests to static assets are free and unlimited.
  //
  // Deploying: Cloudflare runs `npm run build` then `npx wrangler deploy`,
  // which uploads ./out. Nothing else to configure.
  "name": "hit-the-coast",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./out",

    // Serve out/404.html, with a real 404 status, for anything unmatched.
    "not_found_handling": "404-page",

    // /about serves about.html; /coast/ serves coast/index.html.
    "html_handling": "auto-trailing-slash"
  },

  // hitthecoast.com itself is attached as a Custom Domain from the Cloudflare
  // dashboard (Worker → Settings → Domains & Routes), so it does not appear
  // here. www.hitthecoast.com is a plain Route instead: a CNAME record for
  // "www" → hitthecoast.com already exists in DNS (Proxied), and this tells
  // that hostname which Worker to hit. Provisioned this way because the
  // dashboard's "Add Route" / "Add Custom Domain" search box was not finding
  // the zone by itself — deploying this config creates the route directly via
  // the API instead, which does not go through that search box.
  "routes": [
    { "pattern": "www.hitthecoast.com/*", "zone_name": "hitthecoast.com" }
  ]
}
